                                    {{ \Illuminate\Support\Str::limit(strip_tags($notif->message), 60) }}
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <span class="sima-badge {{ $tm['cls'] }}" style="{{ !$tm['cls'] ? 'background:var(--c-border);color:var(--c-text-2);' : '' }}">
                                    {{ $tm['label'] }}
                                </span>
                            </td>
                            <td style="text-align:center;">
                                <span class="sima-badge sima-badge--blue">{{ $notif->total_penerima }}</span>
                            </td>
