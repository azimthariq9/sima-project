                        @foreach($riwayat as $notif)
                        @php
                            $typeMap = [
                                'broadcast'    => ['label' => 'Broadcast',    'cls' => 'sima-badge--blue'],
                                'document'     => ['label' => 'Dokumen',      'cls' => 'sima-badge--amber'],
                                'account'      => ['label' => 'Akun',         'cls' => 'sima-badge--green'],
                                'announcement' => ['label' => 'Pengumuman',   'cls' => 'sima-badge--purple'],
                            ];
                            $tm = $typeMap[$notif->type] ?? ['label' => $notif->type, 'cls' => ''];
                            $pct = $notif->total_penerima > 0
                                ? round($notif->total_dibaca / $notif->total_penerima * 100)
                                : 0;
                        @endphp
                        <tr>
                            <td style="max-width:200px;">
                                <div class="fw-600" style="font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
